<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged by the linker with its default manifest, which already requests
     the asInvoker execution level. Qt sets the DPI awareness itself. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Paths longer than MAX_PATH work when the system enables them. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- Narrow C and Win32 calls, including those inside libssh2 and
           OpenSSL, read UTF-8 paths on Windows 10 1903 and later. OpenSCP's
           own code converts paths to UTF-16 and does not depend on it. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>

# Text files use LF in the repository and in every checkout, whatever
# core.autocrlf says, so Windows checkouts match macOS and Linux ones. Bash
# fails on scripts with CRLF line endings.
* text=auto eol=lf

# cmd.exe can misread batch files that use LF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Patches in vcpkg ports may hold whitespace that belongs to the patched
# content, as vcpkg itself declares.
vcpkg-ports/**/*.patch -whitespace
vcpkg-ports/**/*.diff -whitespace
